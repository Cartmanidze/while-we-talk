#!/bin/sh
set -eu
umask 077
venv="$HOME/.local/share/while-we-talk/whisper"
python3 -m venv "$venv"
"$venv/bin/python" -m pip install --disable-pip-version-check 'faster-whisper==1.2.1'
"$venv/bin/python" -c 'from faster_whisper.utils import download_model; download_model("small")'
echo 'Whisper готов. Открой While We Talk заново.'
